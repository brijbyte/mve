{
  "name": "@brijbyte/mve",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brijbyte/mve.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./languages": {
      "types": "./dist/languages.d.mts",
      "import": "./dist/languages.mjs",
      "require": "./dist/languages.cjs",
      "default": "./dist/languages.mjs"
    },
    "./languages/*": {
      "types": "./dist/languages/*.d.mts",
      "import": "./dist/languages/*.mjs",
      "require": "./dist/languages/*.cjs",
      "default": "./dist/languages/*.mjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/css": "^1.3.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "^1.5.4",
    "@lezer/json": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  }
}
